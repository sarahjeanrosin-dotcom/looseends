# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Standalone Anthropic API key (console.anthropic.com — separate from claude.ai).
# Used in Stage 3 for the AI relevance pass.
ANTHROPIC_API_KEY=sk-ant-...

# SITE_PASSWORD is not used — this site is gated via Netlify's built-in
# Visitor Access (Site configuration > Visitor access) instead of an
# app-level password check. See the README's "Password protection" section.

# Sitemap the Stage 2 website crawler starts from. Optional — defaults to
# https://www.getgenea.com/sitemap.xml if unset.
WEBSITE_SITEMAP_URL=https://www.getgenea.com/sitemap.xml
